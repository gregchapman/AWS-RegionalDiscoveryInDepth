# ══════════════════════════════════════════════════════════════
# Discovery In-Depth — .gitignore
#
# All scan output contains customer account data: resource IDs,
# IPs, ARNs, security group rules, DNS names, etc.
# NONE of it belongs in version control.
# ══════════════════════════════════════════════════════════════

# ── Scan output (all formats, any output folder) ──
output/
*-output/
**/iac-templates/

# ── Inventory files (contain full account resource details) ──
inventory-*.yaml
inventory-*.json
inventory-*.csv
inventory-*.mermaid.md
summary.txt

# ── Service enumerator results ──
# These contain account IDs, service lists, and resource counts.
enum-results.yaml
**/enum-results*.yaml

# ── Customer-specific pipeline configs ──
# Files that reference specific accounts or org structures.
OAG-*.yaml
TG-*.yaml
include.yaml
exclude.yaml

# ── Auto-generated templates (account/region-specific) ──
# Hand-crafted templates in templates/*.yaml are safe to commit.
# Auto-generated ones are derived from live account introspection.
templates/auto/
templates/*-auto/
**/_discovery-schemas/
**/auto-templates/

# ── Credentials and secrets ──
.env
.env.*
*.pem
*.key
credentials
credentials.*
aws_credentials*
*.b64

# ── Encoded/compressed customer data ──
*.zip
*.tar.gz
*.tgz

# ── Zone.Identifier files (WSL/Windows artifact) ──
*.Identifier

# ── Python ──
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/
*.egg

# ── Virtual environments ──
.venv/
venv/
ENV/

# ── IDE / editor ──
.vscode/
.idea/
.kiro/
*.swp
*.swo
*~

# ── OS artifacts ──
.DS_Store
Thumbs.db
Desktop.ini
