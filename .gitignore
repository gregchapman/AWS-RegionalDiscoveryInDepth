# ══════════════════════════════════════════════════════════════
# Discovery In-Depth — .gitignore
#
# All scan output contains customer account data: resource IDs,
# IPs, ARNs, security group rules, DNS names, etc.
# NONE of it belongs in version control.
# ══════════════════════════════════════════════════════════════

# ── Scan output (all formats, any output folder) ──
output/
*-output/
**/iac-templates/

# ── Service enumerator results ──
# These contain account IDs, service lists, and resource counts.
# Current convention: loose YAML files in the repo root or output/.
# Future convention: namespaced under output/<account>/<region>/<timestamp>/
enum-results.yaml
**/enum-results*.yaml

# ── Customer-specific pipeline configs ──
# Files like OAG-CS-Fargate.yaml, TG-TWDB-example.yaml, etc.
# that reference specific accounts or org structures.
OAG-*.yaml
TG-*.yaml

# ── Auto-generated templates (account/region-specific) ──
# Hand-crafted templates in templates/*.yaml are safe to commit.
# Auto-generated ones are derived from live account introspection.
templates/auto/
templates/*-auto/
**/_discovery-schemas/
**/auto-templates/

# ── Zone.Identifier files (WSL/Windows artifact) ──
*.Identifier

# ── Python ──
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/
*.egg

# ── Virtual environments ──
.venv/
venv/
ENV/

# ── IDE / editor ──
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS artifacts ──
.DS_Store
Thumbs.db
Desktop.ini
